[Unit]
Description=Graph Store mirror patrol (log insights + drift/upgrade detection + auto-heal)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=__DATA__
Environment=ASSET_REPO_ROOT=__DATA__
Environment=ASSET_ROOT=__DATA__/assets
Environment=MIRROR_ENGINE_URL=__MIRROR_ENGINE_URL__
Environment=GRAPH_STORE_LOG_DIR=__DATA__/logs
ExecStart=__NODE__ __PKG__/mcp/patrol.js --heal
