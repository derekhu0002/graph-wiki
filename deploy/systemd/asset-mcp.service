[Unit]
Description=Graph Store (asset MCP HTTP/SSE service)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=__DATA__
EnvironmentFile=__DATA__/graph-store.env
Environment=ASSET_REPO_ROOT=__DATA__
Environment=ASSET_ROOT=__DATA__/assets
Environment=ASSET_GIT_DIR=__DATA__
Environment=ASSET_MCP_HOST=__GRAPH_STORE_HOST__
Environment=ASSET_MCP_PORT=__GRAPH_STORE_PORT__
Environment=MIRROR_ENGINE_URL=__MIRROR_ENGINE_URL__
ExecStart=__NODE__ __PKG__/mcp/asset-mcp-server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
