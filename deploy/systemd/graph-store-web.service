[Unit]
Description=Graph Store community website (static site served from the package)
After=network.target

[Service]
Type=simple
User=root
Environment=GRAPH_STORE_WEB_ROOT=__PKG__/website/build
Environment=GRAPH_STORE_WEB_BASE=__WEB_BASE__
Environment=GRAPH_STORE_WEB_HOST=__WEB_HOST__
Environment=GRAPH_STORE_WEB_PORT=__WEB_PORT__
ExecStart=__NODE__ __PKG__/mcp/static-server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
