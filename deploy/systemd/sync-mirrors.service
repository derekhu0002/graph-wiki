[Unit]
Description=Sync all federation mirrors via ARGO mirror engine
After=network.target

[Service]
Type=oneshot
WorkingDirectory=__DATA__
Environment=ASSET_REPO_ROOT=__DATA__
Environment=ASSET_ROOT=__DATA__/assets
Environment=MIRROR_ENGINE_URL=__MIRROR_ENGINE_URL__
ExecStart=__NODE__ __PKG__/mcp/sync-mirrors.js
