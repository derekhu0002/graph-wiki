# Graph Store + ARGO Mirror Engine 部署配置（复制为 deploy/graph-store.env 后按需修改）
# install-graph-store.sh 会读取本文件（或同等环境变量）。

# ---- Graph Store（asset MCP 对外服务）----
GRAPH_STORE_HOST=127.0.0.1
GRAPH_STORE_PORT=18792
# ASSET_ROOT=            # 留空则默认 <DATA_DIR>/assets

# ---- 社区网站（随包提供的预构建静态站）----
INSTALL_WEB=true
WEB_HOST=127.0.0.1
WEB_PORT=18793
WEB_BASE=/archgraph/

# ---- 镜像引擎（ARGO + Neo4j + embedding）----
# true: 在本机安装/启动引擎；false: 指向已有引擎（配 MIRROR_ENGINE_URL）
INSTALL_ENGINE=true
MIRROR_HOST=127.0.0.1
MIRROR_PORT=18801
# MIRROR_ENGINE_URL=     # 留空则用 http://<MIRROR_HOST>:<MIRROR_PORT>

# ---- Neo4j（引擎依赖；需支持多 database，即 Enterprise）----
NEO4J_IMAGE=neo4j:5.26-enterprise
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_STRONG
NEO4J_HEAP=1g
NEO4J_PAGECACHE=512m

# ---- Embedding（阿里 Qwen / OpenAI 兼容）----
ARGO_EMBEDDING_BASE_URL=https://llm-clids9mqc5o1mbvb.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ARGO_EMBEDDING_MODEL=qwen3.7-text-embedding
ARGO_EMBEDDING_MODEL_VERSION=qualification-2026-07-25
ARGO_EMBEDDING_DIMENSIONS=1536
QWEN_KEY=CHANGE_ME

# ---- 语义检索（rerank 可选）----
ARGO_SEMANTIC_HYBRID=0
ARGO_SEMANTIC_MEMORY_THRESHOLD=0.70
# 提供 ARGO_RERANK_API_KEY 才开启 rerank；不填则关闭（仅用 Qwen embedding 检索）。
# ARGO_RERANK_API_KEY=
# ARGO_RERANK_BASE_URL=
# ARGO_RERANK_MODEL=
# ARGO_RERANK_PROVIDER=

# ---- ARGO 引擎安装 ----
ARGO_NPM_PACKAGE=archgraph-argo
NPM_REGISTRY=https://registry.npmmirror.com
NODE_VERSION=v22.11.0

# ---- 私有成员仓只读凭据（可选；用于 mirror_sync 克隆私有仓）----
GITHUB_TOKEN=

# ---- 对外访问（由 IT 负责，不在本项目部署范围）----
# 本项目只把服务绑到 GRAPH_STORE_HOST:GRAPH_STORE_PORT（默认仅本机 127.0.0.1）。
# 如需对外，由 IT 用反向代理 / Nginx / 网关把 /mcp 与 /graph/read 指到该端口，并处理域名与 TLS。
# 若由外部代理直连本机端口，可将 GRAPH_STORE_HOST 设为 0.0.0.0（或内网 IP）。
