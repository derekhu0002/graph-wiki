# Graph Store + ARGO Mirror Engine 部署配置（复制为 deploy/graph-store.env 后按需修改）
# install-graph-store.sh 会读取本文件（或同等环境变量）。

# ---- Graph Store（asset MCP 对外服务）----
GRAPH_STORE_HOST=127.0.0.1
GRAPH_STORE_PORT=18792
# ASSET_ROOT=            # 留空则默认 <DATA_DIR>/assets

# ---- 社区网站（随包提供的预构建静态站）----
INSTALL_WEB=true
WEB_HOST=127.0.0.1
WEB_PORT=18793
WEB_BASE=/archgraph/

# ---- 镜像引擎（ARGO + Neo4j + embedding）----
# true: 在本机安装/启动引擎；false: 指向已有引擎（配 MIRROR_ENGINE_URL）
INSTALL_ENGINE=true
MIRROR_HOST=127.0.0.1
MIRROR_PORT=18801
# MIRROR_ENGINE_URL=     # 留空则用 http://<MIRROR_HOST>:<MIRROR_PORT>

# ---- Neo4j 容器（引擎依赖；需支持多 database，即 Enterprise）----
# 基础设施参数归 Graph Store；**凭据归 ARGO 引擎**（~/.argo/.env）：安装器从
# ARGO_NEO4J_DATABASE_PASSWORD 读取，缺失则生成随机并写回；无需在 Graph Store env 保存。
NEO4J_IMAGE=neo4j:5.26-enterprise
NEO4J_USER=neo4j
# NEO4J_PASSWORD=            # 可选显式覆盖；正常留空（引擎侧 ~/.argo/.env 管理）
NEO4J_HEAP=1g
NEO4J_PAGECACHE=512m

# ---- ARGO 引擎配置（归属 ~/.argo/.env，由 ARGO 引擎直接消费）----
# embedding / QWEN_KEY / 语义 gates / rerank 均属引擎侧配置：通常由 ARGO 自行管理；
# 此处留空即“不改动 ~/.argo/.env”。仅当需要由本安装器覆盖时才填写（可选）。
# ARGO_EMBEDDING_BASE_URL=
# ARGO_EMBEDDING_MODEL=
# ARGO_EMBEDDING_MODEL_VERSION=
# ARGO_EMBEDDING_DIMENSIONS=
# QWEN_KEY=
# ARGO_SEMANTIC_HYBRID=
# ARGO_SEMANTIC_MEMORY_THRESHOLD=
# ARGO_RERANK_API_KEY=
# ARGO_RERANK_BASE_URL=
# ARGO_RERANK_MODEL=
# ARGO_RERANK_PROVIDER=

# ---- ARGO 引擎安装 ----
ARGO_NPM_PACKAGE=archgraph-argo
# 安装根（默认 ~/.argo）与版本标记（可选；用于 /health/patrol 的版本可观测与升级信号）
# ARGO_ROOT=/root/.argo
# ARGO_VERSION=
# beta 通道：ARGO_NPM_PACKAGE=archgraph-argo-beta（注意其 argo-deploy bin 与 stable 冲突，
# 需 prefix 安装或 --force；建议先金丝雀验证后再切换）
NPM_REGISTRY=https://registry.npmmirror.com
NODE_VERSION=v22.11.0

# ---- 私有成员仓只读凭据（可选；用于 mirror_sync 克隆私有仓）----
GITHUB_TOKEN=

# ---- 巡检与可观测（vlog JSONL → graph-store-patrol.timer 每 15 分钟）----
# 日志目录：默认 <DATA_DIR>/logs（service 单元已注入 GRAPH_STORE_LOG_DIR）
# PATROL_WINDOW_MS=86400000        # 巡检聚合窗口（默认 24h）
# PATROL_DENY_RATE_WARN=0.5        # 读拒绝率告警阈值
# PATROL_MIN_READS=20              # 低于该读次数不评估拒绝率
# PATROL_STALE_MS=7200000          # 副本超过该时长未同步才做上游漂移比对（默认 2h）

# ---- 对外访问（由 IT 负责，不在本项目部署范围）----
# 本项目只把服务绑到 GRAPH_STORE_HOST:GRAPH_STORE_PORT（默认仅本机 127.0.0.1）。
# 如需对外，由 IT 用反向代理 / Nginx / 网关把 /mcp 与 /graph/read 指到该端口，并处理域名与 TLS。
# 若由外部代理直连本机端口，可将 GRAPH_STORE_HOST 设为 0.0.0.0（或内网 IP）。
